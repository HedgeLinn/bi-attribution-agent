# Python 编译产物
__pycache__/
*.py[cod]
*.pyc
.pytest_cache/
.venv/
venv/

# 环境变量（勿提交真实 Key）
.env
.env.local

# 运行日志
*.log

# Streamlit 会话持久化：运行时状态，每跑一次都会变
chat_history.json

# 导入的待确认包暂存区：上传后的中间态，确认（或跳过）后就搬进 datasets/<id>/ 并删掉它。
# 它是一份**没经过人工闸门**的自动推断地图，绝不能入库（datasets/ 本身是入库的）。
datasets/.pending/
# 需求沟通内容（本轮需求讨论，不入库）
# 注意：gitignore 里没有 `./` 前缀写法 —— `./需求沟通` 是无效规则，会静默不生效
/需求沟通/

# 运行时会话 PID（run.ps1 启动服务时写入）
.agent.pid