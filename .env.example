# BI-Herness 环境变量示例
# 复制本文件为 .env 并填入真实 Key,或直接设置环境变量。模型接入支持两种协议,
# 二选一即可(同时设置时 Anthropic 协议优先):
#
# 1) Anthropic 协议(阿里云百炼 token-plan 应用端点,模型 deepseek-v4-pro-0813):
#   PowerShell:  $env:ANTHROPIC_AUTH_TOKEN = "sk-xxx"
#   Bash:        export ANTHROPIC_AUTH_TOKEN="sk-xxx"
ANTHROPIC_AUTH_TOKEN=sk-your-key-here
ANTHROPIC_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/apps/anthropic
# BI_MAX_TOKENS=8192                        # 可选,Anthropic 协议输出预算

# 2) OpenAI 协议(new-api 网关,模型 deepseek-v4-flash):
#   PowerShell:  $env:BI_API_KEY = "sk-xxx"
#   Bash:        export BI_API_KEY="sk-xxx"
BI_API_KEY=sk-your-key-here
BI_API_BASE=http://new-api.mypy.cn/v1
